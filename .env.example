# API (apps/api y docker-compose)
SENTINEL_API_KEY=cambia_esto
SENTINEL_PORT=3500
SENTINEL_DATA_DIR=./data
# Clones y working copy por proyecto (cada id en un subdirectorio)
SENTINEL_PROJECTS_DIR=./projects

# Opcional: listar repos en la UI (GET /api/github/repos)
GITHUB_TOKEN=

# System dashboard real host access (docker-compose / sentinel-api)
# Ejecuta probes dentro del namespace del host (requiere util-linux + privileged).
SENTINEL_USE_HOST_NSENTER=true
# Ruta real en el host del script para "Run now" (ejemplo).
SENTINEL_MAINTENANCE_SCRIPT=/usr/local/bin/sentinel_maintenance.sh

# UI local (apps/ui) — Vite solo lee variables con prefijo VITE_
VITE_API_URL=http://localhost:3500
VITE_API_KEY=cambia_esto

# Docker UI build (opcional, docker-compose pasa build args)
# VITE_API_URL=http://tu-servidor:3500
